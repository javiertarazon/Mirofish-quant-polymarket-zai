# Versioned data API configuration for public/free statistical data sources.
# Do NOT place personal wallets, private keys, paid secrets, or Telegram tokens here.
# Local `.env` and `config/.env` files are loaded after this file and can override values.

# Public Polymarket data endpoints. These are not wallet credentials.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com

# News/statistical data keys currently available for the app.
GNEWS_API_KEY=3f7a2c309c285863ef77c5f5778f556e
CURRENTS_API_KEY=WEY8U86-ybAsblAqOf8J5FR4ve500xHnDxwCVqABMd_iSGOY
RAPIDAPI_KEY=9e380915a4msh59d32c576401b8ap185ebfjsn3408c70333a3
THESPORTSDB_API_KEY=123
FOOTBALL_DATA_API_KEY=ff2b01adb08842ccb3f479cd3965a4c2

# Optional data providers not currently present in this repository.
# Fill these in `.env` or `config/.env` when available.
NEWS_API_KEY=
API_SPORTS_KEY=
API_SPORTS_HOST=
ODDS_API_KEY=

# Personal/sensitive credentials must remain local only.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
