EXCLUDED_MARKET_TERMS=crypto price,bitcoin,ethereum

MIN_LIQUIDITY=1000
MIN_VOLUME=1000
MAX_SPREAD=0.08
MIN_EXPECTED_VALUE=0.03
MIN_CONFIDENCE=70
MIN_PROBABILITY_EDGE=0.04
MIN_UNDERVALUATION_GAP=0.04

TOP_TRADER_MIN_EFFECTIVENESS=0.08
TOP_TRADER_MIN_MONTHLY_VOLUME=10000
TOP_TRADER_MIN_RELEVANT_NOTIONAL=1000

SWARM_ENABLED=true
MAX_SWARM_PROBABILITY_SHIFT=0.08
MAX_SWARM_CONFIDENCE_BOOST=12
