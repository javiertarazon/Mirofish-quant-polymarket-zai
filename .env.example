DATABASE_URL=file:./dev.db
NODE_ENV=development
LOG_LEVEL=info
RUN_ONCE=false
TRADING_CYCLE_MS=1800000

POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
